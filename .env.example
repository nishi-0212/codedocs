# Required. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# ---- Optional tuning (defaults shown, sized for Groq's free tier) ----
# Max characters of code accepted per request
# MAX_INPUT_CHARS=100000
# Characters per chunk when a large input is split. Raise on a paid Groq plan.
# CHUNK_CHARS=10000
# Max tokens the model may write per chunk
# MAX_OUTPUT_TOKENS=4000
# Requests allowed per minute per IP
# RATE_LIMIT_PER_MIN=12
# Override the API base URL (e.g. a proxy). Must be OpenAI-compatible.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
